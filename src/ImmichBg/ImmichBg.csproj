<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <!-- windows10.0.19041 gives access to the WinRT LockScreen API -->
    <TargetFramework>net10.0-windows10.0.19041.0</TargetFramework>
    <SupportedOSPlatformVersion>10.0.17763.0</SupportedOSPlatformVersion>
    <Nullable>enable</Nullable>
    <UseWindowsForms>true</UseWindowsForms>
    <ImplicitUsings>enable</ImplicitUsings>
    <ApplicationHighDpiMode>PerMonitorV2</ApplicationHighDpiMode>
    <AssemblyName>ImmichBg</AssemblyName>
    <RootNamespace>ImmichBg</RootNamespace>
    <Product>Immich BG</Product>
    <Version>0.1.0</Version>
    <ApplicationIcon>app.ico</ApplicationIcon>
    <!-- Low footprint: no background GC thread, only English framework resources -->
    <ConcurrentGarbageCollection>false</ConcurrentGarbageCollection>
    <SatelliteResourceLanguages>en</SatelliteResourceLanguages>
  </PropertyGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="ImmichBg.Tests" />
  </ItemGroup>

  <ItemGroup>
    <!-- Regenerate with tools/make-icons.ps1 -->
    <EmbeddedResource Include="app.ico" LogicalName="app.ico" />
    <EmbeddedResource Include="Assets\logo.png" LogicalName="logo.png" />
    <EmbeddedResource Include="Assets\logo-small.png" LogicalName="logo-small.png" />
  </ItemGroup>

</Project>
